#!/bin/sh
# X session for the SilkOS live image. Starts a tiny window manager, then SilkOS fullscreen.
# Boot options (press Tab/e at the boot menu and append):
#   silkos.gpu        use GPU acceleration even inside a VM (default in VMs: software rendering)
#   silkos.nosandbox  start Electron with --no-sandbox (debug only)
export SILKOS_KIOSK=1
CMDLINE="$(cat /proc/cmdline)"
case "$CMDLINE" in
  *silkos.gpu*) ;;
  *) if systemd-detect-virt -q 2>/dev/null; then export SILKOS_SOFTWARE=1; fi ;;
esac
FLAGS=""
case "$CMDLINE" in *silkos.nosandbox*) FLAGS="--no-sandbox" ;; esac

xset s off; xset -dpms; xset s noblank
# Use the image-wide config so stale per-user Openbox settings cannot override
# the SilkOS decorations for Flatpak, Wine, terminal, and other app windows.
OPENBOX_RC=/etc/xdg/openbox/rc.xml
if [ ! -r "$OPENBOX_RC" ]; then
  echo "Openbox config is missing: $OPENBOX_RC" >>/tmp/openbox.log
  exit 1
fi
openbox --config-file "$OPENBOX_RC" >/tmp/openbox.log 2>&1 &
OPENBOX_PID=$!
tries=0
until wmctrl -m >/dev/null 2>&1; do
  if ! kill -0 "$OPENBOX_PID" 2>/dev/null || [ "$tries" -ge 50 ]; then
    echo "Openbox did not become the window manager; see /tmp/openbox.log" >&2
    exit 1
  fi
  tries=$((tries + 1))
  sleep 0.1
done
wmctrl -n 4
if command -v touchegg >/dev/null 2>&1; then
  GESTURE_CONFIG="$HOME/.config/touchegg/touchegg.conf"
  if [ ! -f "$GESTURE_CONFIG" ] && [ -r /usr/share/silkos/touchegg.conf ]; then
    mkdir -p "$(dirname "$GESTURE_CONFIG")"
    cp /usr/share/silkos/touchegg.conf "$GESTURE_CONFIG"
  fi
  touchegg >/tmp/touchegg.log 2>&1 &
fi

# X11 window managers draw frames but cannot round their corners. Match the
# 18 CSS-pixel SilkOS window radius at the current Xft display scale.
CORNER_RADIUS="$(xrdb -query 2>/dev/null | awk '
  $1 == "Xft.dpi:" && ($2 + 0) > 0 {
    printf "%d\n", (18 * $2 / 96) + 0.5
    found = 1
    exit
  }
  END { if (!found) print 18 }
')"
picom --config /dev/null --backend xrender --corner-radius "$CORNER_RADIUS" \
  --shadow --shadow-radius 18 --shadow-opacity 0.28 \
  --shadow-offset-x -8 --shadow-offset-y -8 --no-vsync \
  >/tmp/picom.log 2>&1 &
PICOM_PID=$!
sleep 0.5
if ! kill -0 "$PICOM_PID" 2>/dev/null; then
  echo "Picom failed to start; rounded app windows are unavailable. See /tmp/picom.log" >&2
fi

APP="$(command -v silkos || echo /opt/SilkOS/silkos)"
# Restart SilkOS if it ever exits or crashes, so you never end up on a black screen.
while :; do
  "$APP" $FLAGS >>/tmp/silkos.log 2>&1
  sleep 1
done
