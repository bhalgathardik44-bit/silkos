#!/bin/sh
# Turn an EMPTY disk into SilkOS's live-boot persistence storage.
# Refuses any disk that already has partitions or a filesystem.
set -e
d="/dev/$1"
[ -b "$d" ] && [ "$(lsblk -dno TYPE "$d")" = disk ] || { echo "Not a disk"; exit 1; }
[ "$(lsblk -no NAME "$d" | wc -l)" -eq 1 ] && [ -z "$(lsblk -dno FSTYPE,PTTYPE "$d" | tr -d ' ')" ] || { echo "Disk is not empty"; exit 1; }
echo 'type=83' | sfdisk -q "$d"
udevadm settle || sleep 2
p=$(lsblk -lnpo NAME,TYPE "$d" | awk '$2=="part"{print $1; exit}')
mkfs.ext4 -q -F -L persistence "$p"
m=$(mktemp -d)
mount "$p" "$m"
echo '/ union' > "$m/persistence.conf"
umount "$m"
rmdir "$m"
