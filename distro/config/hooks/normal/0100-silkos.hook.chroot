#!/bin/sh
set -e
# Make sure SilkOS's dependencies are satisfied and the Chromium sandbox helper is usable.
apt-get install -y -f || true
[ -f /opt/SilkOS/chrome-sandbox ] && chmod 4755 /opt/SilkOS/chrome-sandbox || true
# Wi-Fi/Ethernet management through NetworkManager
systemctl enable NetworkManager || true
# Match native app windows to SilkOS and place their controls on the left.
OPENBOX_RC=/etc/xdg/openbox/rc.xml
OPENBOX_THEME=/usr/share/themes/SilkOS/openbox-3/themerc
test -f "$OPENBOX_RC"
test -f "$OPENBOX_THEME"
sed -i '/<theme>/,/<\/theme>/ {
  s|<name>[^<]*</name>|<name>SilkOS</name>|
  s|<titleLayout>[^<]*</titleLayout>|<titleLayout>CIML</titleLayout>|
}' "$OPENBOX_RC"
sed -i '/<keybind key="A-Tab">/,/<\/keybind>/d; /<keybind key="A-S-Tab">/,/<\/keybind>/d' "$OPENBOX_RC"
grep -q '<name>SilkOS</name>' "$OPENBOX_RC"
grep -q '<titleLayout>CIML</titleLayout>' "$OPENBOX_RC"
! grep -q '<keybind key="A-\(S-\)\?Tab">' "$OPENBOX_RC"
