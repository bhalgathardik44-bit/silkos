#!/bin/sh
set -e
# Make sure SilkOS's dependencies are satisfied and the Chromium sandbox helper is usable.
apt-get install -y -f || true
[ -f /opt/SilkOS/chrome-sandbox ] && chmod 4755 /opt/SilkOS/chrome-sandbox || true
# Wi-Fi/Ethernet management through NetworkManager
systemctl enable NetworkManager || true
# Make BlueZ available to the Control Center on live boots.
systemctl enable bluetooth.service || true
# Match native app windows to SilkOS and place close/minimize/maximize controls on the left.
OPENBOX_RC=/etc/xdg/openbox/rc.xml
OPENBOX_THEME=/usr/share/themes/SilkOS/openbox-3/themerc
test -f "$OPENBOX_RC"
test -f "$OPENBOX_THEME"
sed -i '/<theme>/,/<\/theme>/ {
  s|<name>[^<]*</name>|<name>SilkOS</name>|
  s|<titleLayout>[^<]*</titleLayout>|<titleLayout>CIML</titleLayout>|
}' "$OPENBOX_RC"
sed -i '/<desktops>/,/<\/desktops>/ s|<number>[^<]*</number>|<number>4</number>|' "$OPENBOX_RC"
# silkos-xsession rewrites <margins><top> at the display scale to keep native windows out of the
# SilkOS menu bar, so the block has to exist for that substitution to have anything to match.
grep -q '<margins>' "$OPENBOX_RC"
sed -i '/<keybind key="A-Tab">/,/<\/keybind>/d; /<keybind key="A-S-Tab">/,/<\/keybind>/d' "$OPENBOX_RC"
# Openbox grabs Ctrl+Alt+Left/Right for its own desktop switch, which stops SilkOS registering them and
# leaves the switch without its animation. Free them so SilkOS handles both.
sed -i '/<keybind key="C-A-Left">/,/<\/keybind>/d; /<keybind key="C-A-Right">/,/<\/keybind>/d' "$OPENBOX_RC"
grep -q '<name>SilkOS</name>' "$OPENBOX_RC"
grep -q '<titleLayout>CIML</titleLayout>' "$OPENBOX_RC"
grep -q '<number>4</number>' "$OPENBOX_RC"
! grep -q '<keybind key="A-\(S-\)\?Tab">' "$OPENBOX_RC"
! grep -q '<keybind key="C-A-\(Left\|Right\)">' "$OPENBOX_RC"
# polkitd reads its rule files as an unprivileged user, so they must be world-readable.
chmod 0644 /etc/polkit-1/rules.d/49-silkos-radio.rules || true
chmod 0644 /etc/NetworkManager/conf.d/10-silkos-auth.conf || true
chmod 0644 /etc/dbus-1/system.d/silkos-bluetooth.conf || true
chmod 0644 /etc/udev/rules.d/70-silkos-touchpad.rules || true
