#!/bin/sh
set -e

TOUCHEGG_VERSION=2.0.18
TOUCHEGG_DEB=/tmp/touchegg_${TOUCHEGG_VERSION}_amd64.deb
TOUCHEGG_URL="https://github.com/JoseExposito/touchegg/releases/download/${TOUCHEGG_VERSION}/touchegg_${TOUCHEGG_VERSION}_amd64.deb"
TOUCHEGG_SHA256=8e76be8b3bcbd62f0710b8686d896aa9abe22de3a81ab8c4013799ca8522ab5c

apt-get install -y curl dbus-bin
curl --fail --location --silent --show-error --retry 3 "$TOUCHEGG_URL" --output "$TOUCHEGG_DEB"
printf '%s  %s\n' "$TOUCHEGG_SHA256" "$TOUCHEGG_DEB" | sha256sum --check -
apt-get install -y "$TOUCHEGG_DEB"
rm -f "$TOUCHEGG_DEB"

install -d -m 0755 /etc/skel/.config/touchegg
install -m 0644 /usr/share/silkos/touchegg.conf /etc/skel/.config/touchegg/touchegg.conf

# Gestures reach SilkOS over the daemon's D-Bus stream, so the daemon has to run. It ships as a
# system service that reads /dev/input as root with Group=input, which the live user cannot do.
# systemctl cannot talk to a running manager inside the build chroot, so enable the unit by
# linking it the way systemd does.
UNIT=""
for candidate in /etc/systemd/system/touchegg.service /lib/systemd/system/touchegg.service /usr/lib/systemd/system/touchegg.service; do
  if [ -z "$UNIT" ] && [ -f "$candidate" ]; then
    UNIT="$candidate"
  fi
done
if [ -n "$UNIT" ]; then
  install -d -m 0755 /etc/systemd/system/multi-user.target.wants
  ln -sf "$UNIT" /etc/systemd/system/multi-user.target.wants/touchegg.service
else
  echo "Touchégg ships no systemd unit; gestures rely on the session fallback in silkos-xsession" >&2
fi
